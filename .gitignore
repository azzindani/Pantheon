# ── never commit secrets ──
*.env
**/.env
shared.env

# ── local, machine-specific Claude Code overrides ──
.claude/settings.local.json

# ── generated artifact (rebuilt by gen-compose.sh from the agents/ dirs) ──
/docker-compose.yml

# ── generated per-agent brains (memory + data/.env) and the large blank-slate seed ──
/agents/*
!/agents/.gitkeep
/seed/
